# TPS Service — copy to .env and fill in values

# PostgreSQL — same shared database as nrm-seed-generator, which owns the instance.
# TPS keeps all of its own objects in the `tps` schema; the parent owns `public`.
DATABASE_URL=postgresql://buildflow:buildflow@localhost:5433/buildflow
DATABASE_SCHEMA=tps

# Schema owned by the SCMS module in the same database. TPS reads it directly
# (read-only) to source Step 1 shortlist candidates.
SCMS_SCHEMA=scms

# Docker network published by the parent platform's compose stack, joined by TPS.
PARENT_NETWORK=buildflow

# Redis, owned by the parent platform. The worker consumes
# buildflow_takeoff_completion_queue from it and launches a tender preparation workflow
# when a take-off completes. In-container the host is `redis`; from the host it is the
# port the parent publishes.
REDIS_URL=redis://localhost:6379

# BFF
PORT=3200
# Comma-separated. Add http://<your-lan-ip>:5175 to reach the app from a phone.
WEB_ORIGIN=http://localhost:5175
AUTH_DISABLED=true
TOKEN_ENCRYPTION_KEY=change-me-32-chars-minimum-secret

# OIDC (required when AUTH_DISABLED=false)
# OIDC_ISSUER=
# OIDC_AUDIENCE=
# OIDC_JWKS_URI=

# Python API
ENGINE_INTERNAL_TOKEN=tps-internal-dev-token
ENGINE_INTERNAL_URL=http://localhost:8200

# Cloudflare Email Sending. Powers "Confirm ITT" on Step 2 — without these set, ITT
# sends are recorded as failed rather than actually going out.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_EMAIL_TOKEN=

# Resolves ITT document filenames to Dropbox share links. Optional — without it, ITT
# documents still list, just with no link.
# DROPBOX_ACCESS_TOKEN=

# BuildFlow's internal contracts: the document-links route, which resolves a take-off
# package version to long-lived email-safe links for "Confirm ITT" to embed, and the
# spec-clauses route. The SAME pair authenticates both.
#
# The token must equal TPS_INTERNAL_TOKEN on the BuildFlow side or every call 401s; its
# compose default is `buildflow-tps-dev-token`. The base URL is BuildFlow's BFF as reachable
# from this container — `http://bff:3000` on the shared `buildflow` network, not localhost.
#
# Without both, ITT emails still send, and the per-package specification list still fills in
# (it reads the shared database, not HTTP) — but the emails carry no document links, and the
# ITT says so in its review notes rather than looking complete.
BUILDFLOW_BASE_URL=http://bff:3000
BUILDFLOW_DOCUMENT_LINKS_TOKEN=buildflow-tps-dev-token

# Redirects every outbound ITT email to TEST_TO_EMAIL_ACCOUNT instead of the recipient's
# real SCMS contact address — a safe way to exercise "Confirm ITT" against real packages
# without emailing real subcontractors. Both required when the flag is Y.
# TEST_EMAIL_FLAG=N
# TEST_FROM_EMAIL_ACCOUNT=
# TEST_TO_EMAIL_ACCOUNT=

# Dev auth headers (used by web when AUTH_DISABLED=true).
#
# These MUST match the parent platform's (.env VITE_DEV_SUBJECT / VITE_DEV_ORGANIZATION).
# Both repos provision through the same issuer `buildflow-dev` and upsert on
# (oidc_issuer, external_id), so a different external id here mints a SECOND
# bf_organizations row with a different UUID. A workflow launched by the take-off worker
# carries the parent's organization_id, and every TPS read filters on organization_id —
# so a mismatch does not error, it just makes the workflow invisible.
VITE_API_URL=http://localhost:3200
VITE_MAIN_APP_URL=http://localhost:5173
VITE_DEV_SUBJECT=local-user
VITE_DEV_ORGANIZATION=local-org
VITE_DEV_EMAIL=dev@example.com
