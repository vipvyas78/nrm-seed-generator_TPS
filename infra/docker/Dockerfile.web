FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/
RUN corepack enable && pnpm install --no-frozen-lockfile
COPY tsconfig.base.json ./
COPY apps/web ./apps/web
# Every VITE_* value is inlined by Vite at build time, so these must be build ARGs —
# setting them in the container's runtime environment has no effect on the shipped bundle.
ARG VITE_API_URL=http://localhost:3200
ARG VITE_MAIN_APP_URL=http://localhost:5173
# The dev-auth bypass, DEFAULTED OFF since issue #37 gave BuildFlow a login screen.
#
# The old comment here was right about the mechanics and is now the problem: with these
# baked in, the browser never needed a session, so BuildFlow's login screen never
# appeared and TPS never exercised the shared one either.
#
# TPS does not sign anyone in — `public.bf_user_sessions` is BuildFlow's to mint, because
# two applications creating sessions against one table would be two password policies and
# two lockout counters. So TPS is now reached at /tps/ on BuildFlow's own origin (see
# BuildFlow's infra/docker/nginx-web.conf), where the session in `sessionStorage` is
# already there to be read. Reaching TPS on :5175 directly is a DIFFERENT origin and will
# 401 until somebody signs in on that origin — which is the honest answer, not a bug.
#
# To restore the old bypass for a throwaway container, pass them explicitly:
#   --build-arg VITE_DEV_SUBJECT=local-user --build-arg VITE_DEV_ORGANIZATION=local-org
ARG VITE_DEV_SUBJECT=
ARG VITE_DEV_ORGANIZATION=
ARG VITE_DEV_EMAIL=
ENV VITE_API_URL=$VITE_API_URL \
    VITE_MAIN_APP_URL=$VITE_MAIN_APP_URL \
    VITE_DEV_SUBJECT=$VITE_DEV_SUBJECT \
    VITE_DEV_ORGANIZATION=$VITE_DEV_ORGANIZATION \
    VITE_DEV_EMAIL=$VITE_DEV_EMAIL
RUN pnpm --filter @tps/web build

FROM nginx:alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx-web.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
