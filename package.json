{
  "name": "buildflow-tps",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": "24.13.1",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "dev:bff": "pnpm --filter @tps/bff dev",
    "dev:web": "pnpm --filter @tps/web dev",
    "migrate": "pnpm --filter @tps/bff migrate"
  }
}
