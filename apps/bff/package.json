{
  "name": "@tps/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "send-sample-itt": "tsx --env-file=../../.env src/sendSampleItt.ts",
    "send-test-itt": "tsx --env-file=../../.env src/sendTestItt.ts",
    "send-test-reminders": "tsx --env-file=../../.env src/sendTestReminders.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "bullmq": "^5.58.0",
    "cloudflare": "^7.0.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "jose": "^6.0.5",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
