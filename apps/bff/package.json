{
  "name": "@tps/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.13.1" },
  "scripts": {
    "dev": "tsx --env-file=../../.env watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file=../../.env src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.2.1",
    "jose": "^6.0.5",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
